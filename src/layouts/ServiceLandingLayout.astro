---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config/site";
import { projects } from "@/data/projects";

interface ServiceHero {
  tagline: string;
  headline: string;
  subheadline: string;
  primaryCTA: { text: string; href: string };
  secondaryCTA: { text: string; href: string };
  trustLine?: string;
  visual: "website" | "seo" | "google-ads" | "meta-ads" | "tracking" | "crm";
}
interface Problem {
  icon: string;
  title: string;
  description: string;
}
interface Solution {
  icon: string;
  title: string;
  description?: string;
}
interface PricingCard {
  name: string;
  price: string;
  period?: string;
  bestFor: string;
  items: string[];
  highlighted?: boolean;
}
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  metadata: { title: string; description: string };
  hero: ServiceHero;
  problems: Problem[];
  solutions: Solution[];
  included: string[];
  pricing: PricingCard[];
  faq: FAQItem[];
}

const { metadata, hero, problems, solutions, included, pricing, faq } =
  Astro.props as Props;

const processSteps = [
  {
    step: "01",
    title: "Free Consultation",
    description:
      "We discuss your business, services, goals, and current website or marketing situation — no pressure, no obligation.",
  },
  {
    step: "02",
    title: "Audit & Plan",
    description:
      "I review your website, SEO, ads, tracking, or lead flow and identify the most important improvements.",
  },
  {
    step: "03",
    title: "Build & Set Up",
    description:
      "I create the pages, structure, tracking, campaigns, or workflows your project needs.",
  },
  {
    step: "04",
    title: "Launch, Track & Improve",
    description:
      "After launch, we review performance, user behavior, and leads — then plan the next step.",
  },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
});

const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: hero.tagline,
  description: metadata.description,
  provider: {
    "@type": "LocalBusiness",
    name: siteConfig.name,
    url: siteConfig.url,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Vancouver",
      addressRegion: "WA",
      addressCountry: "US",
    },
  },
  areaServed: ["Vancouver WA", "Clark County WA", "Portland Metro OR"],
});
---

<BaseLayout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={faqSchema} />
    <script is:inline type="application/ld+json" set:html={serviceSchema} />
  </Fragment>

  <!-- ─── 1. HERO ─────────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden pt-8 pb-14 md:pt-12 md:pb-20">
    <!-- subtle bg gradient -->
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-linear-to-br from-primary/5 via-transparent to-transparent"
    >
    </div>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
        <!-- Left: text -->
        <div>
          <!-- Tagline badge -->
          <div
            class="mb-5 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3 py-1"
          >
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span
                class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary/60 opacity-75 motion-reduce:animate-none"
              ></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-primary"
              ></span>
            </span>
            <span class="text-xs font-semibold text-primary"
              >{hero.tagline}</span
            >
          </div>

          <h1
            class="mb-5 text-4xl font-extrabold tracking-tight text-foreground md:text-5xl lg:text-6xl leading-tight"
          >
            {hero.headline}
          </h1>
          <p
            class="mb-8 text-lg text-muted-foreground leading-relaxed max-w-xl"
          >
            {hero.subheadline}
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row gap-4 mb-6">
            <a
              id="hero-primary-cta"
              href={hero.primaryCTA.href}
              class="inline-flex items-center justify-center rounded-xl bg-primary px-7 py-4 text-base font-bold text-white shadow-lg shadow-primary/30 transition-all hover:bg-primary/90 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
            >
              {hero.primaryCTA.text}
            </a>
            <a
              href={hero.secondaryCTA.href}
              class="inline-flex items-center justify-center rounded-xl border border-border bg-muted px-7 py-4 text-base font-semibold text-foreground transition-all hover:bg-muted/80 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
            >
              {hero.secondaryCTA.text}
            </a>
          </div>

          <!-- Trust line -->
          {
            hero.trustLine && (
              <p class="text-xs text-muted-foreground">{hero.trustLine}</p>
            )
          }
        </div>

        <!-- Right: visual mockup -->
        <div class="flex justify-center lg:justify-end">
          <!-- WEBSITE MOCKUP -->
          {
            hero.visual === "website" && (
              <div class="relative w-full max-w-md">
                <div class="overflow-hidden rounded-2xl border border-gray-200 bg-gray-900 shadow-2xl">
                  <div class="flex items-center gap-3 bg-gray-800 px-4 py-3">
                    <div class="flex gap-1.5">
                      <div class="h-2.5 w-2.5 rounded-full bg-red-400" />
                      <div class="h-2.5 w-2.5 rounded-full bg-yellow-400" />
                      <div class="h-2.5 w-2.5 rounded-full bg-green-400" />
                    </div>
                    <div class="flex-1 rounded bg-gray-700 px-3 py-1 text-xs text-gray-400">
                      yourbusiness.com
                    </div>
                  </div>
                  <div class="space-y-3 bg-white p-4">
                    <div class="flex items-center justify-between border-b border-gray-100 pb-2">
                      <div class="h-3 w-20 rounded bg-blue-600" />
                      <div class="flex items-center gap-2">
                        <div class="h-2 w-8 rounded bg-gray-300" />
                        <div class="h-2 w-8 rounded bg-gray-300" />
                        <div class="h-6 w-20 rounded-lg bg-blue-600" />
                      </div>
                    </div>
                    <div class="rounded-xl bg-blue-50 p-4">
                      <div class="mb-2 h-5 w-4/5 rounded bg-blue-200" />
                      <div class="mb-4 h-3 w-3/5 rounded bg-blue-100" />
                      <div class="h-8 w-32 rounded-lg bg-blue-600" />
                    </div>
                    <div class="grid grid-cols-3 gap-2">
                      <div class="rounded-lg border border-gray-100 bg-gray-50 p-2.5">
                        <div class="mb-2 h-6 w-6 rounded-lg bg-blue-100" />
                        <div class="mb-1 h-1.5 w-full rounded bg-gray-200" />
                        <div class="h-1.5 w-3/4 rounded bg-gray-100" />
                      </div>
                      <div class="rounded-lg border border-gray-100 bg-gray-50 p-2.5">
                        <div class="mb-2 h-6 w-6 rounded-lg bg-green-100" />
                        <div class="mb-1 h-1.5 w-full rounded bg-gray-200" />
                        <div class="h-1.5 w-3/4 rounded bg-gray-100" />
                      </div>
                      <div class="rounded-lg border border-gray-100 bg-gray-50 p-2.5">
                        <div class="mb-2 h-6 w-6 rounded-lg bg-orange-100" />
                        <div class="mb-1 h-1.5 w-full rounded bg-gray-200" />
                        <div class="h-1.5 w-3/4 rounded bg-gray-100" />
                      </div>
                    </div>
                    <div class="flex gap-2">
                      <div class="flex-1 rounded-lg border border-green-200 bg-green-50 p-2 text-center">
                        <div class="text-sm font-bold text-green-700">98</div>
                        <div class="text-xs text-gray-500">SEO</div>
                      </div>
                      <div class="flex-1 rounded-lg border border-green-200 bg-green-50 p-2 text-center">
                        <div class="text-sm font-bold text-green-700">95</div>
                        <div class="text-xs text-gray-500">Speed</div>
                      </div>
                      <div class="flex-1 rounded-lg border border-blue-200 bg-blue-50 p-2 text-center">
                        <div class="text-sm font-bold text-blue-700">✓</div>
                        <div class="text-xs text-gray-500">Mobile</div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="absolute -right-3 -top-3 rounded-full bg-green-500 px-3 py-1.5 text-xs font-bold text-white shadow-lg">
                  Live & Ranking
                </div>
              </div>
            )
          }

          <!-- SEO MOCKUP -->
          {
            hero.visual === "seo" && (
              <div class="relative w-full max-w-md">
                <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl">
                  <div class="bg-blue-600 px-5 py-4">
                    <div class="mb-1.5 text-sm font-semibold text-white">
                      Local Search Rankings
                    </div>
                    <div class="flex items-center gap-2 rounded-lg bg-white/20 px-3 py-1.5">
                      <div class="h-3 w-3 rounded-sm bg-white/50" />
                      <span class="text-xs text-white/90">
                        flooring installer Vancouver WA
                      </span>
                    </div>
                  </div>
                  <div class="space-y-2.5 p-4">
                    <div class="flex items-center gap-3 rounded-xl border border-green-200 bg-green-50 p-3">
                      <span class="w-6 text-center text-sm font-extrabold text-green-700">
                        #1
                      </span>
                      <div class="flex-1">
                        <div class="text-sm font-medium text-blue-600">
                          Your Business Name
                        </div>
                        <div class="text-xs text-gray-500">
                          yourbusiness.com
                        </div>
                      </div>
                      <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-600">
                        Top
                      </span>
                    </div>
                    <div class="flex items-center gap-3 rounded-xl border border-gray-200 bg-gray-50 p-3">
                      <span class="w-6 text-center text-sm font-bold text-gray-400">
                        #3
                      </span>
                      <div class="flex-1">
                        <div class="text-sm text-blue-600">Competitor A</div>
                        <div class="text-xs text-gray-400">
                          competitor-a.com
                        </div>
                      </div>
                    </div>
                    <div class="flex items-center gap-3 rounded-xl border border-gray-200 bg-gray-50 p-3 opacity-60">
                      <span class="w-6 text-center text-sm font-bold text-gray-400">
                        #5
                      </span>
                      <div class="flex-1">
                        <div class="text-sm text-blue-600">Competitor B</div>
                        <div class="text-xs text-gray-400">
                          competitor-b.com
                        </div>
                      </div>
                    </div>
                    <div class="flex items-center gap-3 rounded-xl border border-orange-200 bg-orange-50 p-3">
                      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-orange-100 text-sm">
                        📍
                      </div>
                      <div class="flex-1">
                        <div class="text-sm font-medium text-gray-800">
                          Google Business Profile
                        </div>
                        <div class="text-xs text-gray-500">
                          Map pack visibility
                        </div>
                      </div>
                      <span class="text-xs font-bold text-green-600">
                        Active ✓
                      </span>
                    </div>
                  </div>
                </div>
                <div class="absolute -right-3 -top-3 rounded-full bg-green-500 px-3 py-1.5 text-xs font-bold text-white shadow-lg">
                  Ranking #1
                </div>
              </div>
            )
          }

          <!-- GOOGLE ADS MOCKUP -->
          {
            hero.visual === "google-ads" && (
              <div class="relative w-full max-w-md">
                <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl">
                  <div class="flex items-center justify-between bg-blue-600 px-5 py-4">
                    <div class="text-sm font-semibold text-white">
                      Campaign Performance
                    </div>
                    <span class="rounded-full bg-green-400 px-2 py-0.5 text-xs font-bold text-white">
                      ● Active
                    </span>
                  </div>
                  <div class="grid grid-cols-3 divide-x divide-gray-100 border-b border-gray-100">
                    <div class="p-4 text-center">
                      <div class="text-xl font-bold text-gray-900">1,240</div>
                      <div class="text-xs text-gray-500">Impressions</div>
                    </div>
                    <div class="p-4 text-center">
                      <div class="text-xl font-bold text-gray-900">47</div>
                      <div class="text-xs text-gray-500">Clicks</div>
                    </div>
                    <div class="p-4 text-center">
                      <div class="text-xl font-bold text-green-600">12</div>
                      <div class="text-xs text-gray-500">Leads</div>
                    </div>
                  </div>
                  <div class="p-4">
                    <div class="mb-2 text-xs text-gray-500">
                      Lead trend (30 days)
                    </div>
                    <div class="flex h-12 items-end gap-1">
                      <div
                        class="flex-1 rounded-t bg-blue-200"
                        style="height:12px"
                      />
                      <div
                        class="flex-1 rounded-t bg-blue-200"
                        style="height:20px"
                      />
                      <div
                        class="flex-1 rounded-t bg-blue-200"
                        style="height:16px"
                      />
                      <div
                        class="flex-1 rounded-t bg-blue-300"
                        style="height:28px"
                      />
                      <div
                        class="flex-1 rounded-t bg-blue-300"
                        style="height:24px"
                      />
                      <div
                        class="flex-1 rounded-t bg-blue-400"
                        style="height:36px"
                      />
                      <div
                        class="flex-1 rounded-t bg-blue-400"
                        style="height:32px"
                      />
                      <div
                        class="flex-1 rounded-t bg-blue-500"
                        style="height:44px"
                      />
                      <div
                        class="flex-1 rounded-t bg-blue-500"
                        style="height:40px"
                      />
                      <div
                        class="flex-1 rounded-t bg-blue-600"
                        style="height:48px"
                      />
                    </div>
                  </div>
                  <div class="space-y-2 px-4 pb-4">
                    <div class="flex items-center justify-between rounded-lg bg-gray-50 p-3">
                      <span class="text-sm text-gray-600">Cost per lead</span>
                      <span class="text-sm font-bold text-gray-900">$42</span>
                    </div>
                    <div class="flex items-center justify-between rounded-lg bg-green-50 p-3">
                      <span class="text-sm text-gray-600">
                        Conversion tracking
                      </span>
                      <span class="text-sm font-bold text-green-700">
                        Active ✓
                      </span>
                    </div>
                  </div>
                </div>
                <div class="absolute -right-3 -top-3 rounded-full bg-green-500 px-3 py-1.5 text-xs font-bold text-white shadow-lg">
                  12 Leads / Month
                </div>
              </div>
            )
          }

          <!-- META ADS MOCKUP -->
          {
            hero.visual === "meta-ads" && (
              <div class="relative w-full max-w-md">
                <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl">
                  <div class="flex items-center justify-between bg-blue-700 px-5 py-4">
                    <div class="text-sm font-semibold text-white">
                      Meta Ads Overview
                    </div>
                    <span class="rounded-full bg-green-400 px-2 py-0.5 text-xs font-bold text-white">
                      ● Running
                    </span>
                  </div>
                  <div class="p-4">
                    <div class="overflow-hidden rounded-xl border border-gray-200">
                      <div class="flex items-center gap-2 border-b border-gray-100 bg-gray-50 px-3 py-2">
                        <div class="h-6 w-6 rounded-full bg-blue-600" />
                        <div>
                          <div class="text-xs font-medium text-gray-800">
                            Your Business
                          </div>
                          <div class="text-xs text-gray-400">Sponsored</div>
                        </div>
                      </div>
                      <div class="h-24 bg-blue-100 flex items-center justify-center">
                        <div class="text-center">
                          <div class="mb-1 h-4 w-32 rounded bg-blue-300 mx-auto" />
                          <div class="h-3 w-24 rounded bg-blue-200 mx-auto" />
                        </div>
                      </div>
                      <div class="flex items-center justify-between border-t border-gray-100 px-3 py-2">
                        <div>
                          <div class="h-2.5 w-24 rounded bg-gray-200 mb-1" />
                          <div class="h-2 w-16 rounded bg-gray-100" />
                        </div>
                        <div class="rounded-md border border-blue-600 px-3 py-1 text-xs font-semibold text-blue-600">
                          Learn More
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="grid grid-cols-3 divide-x divide-gray-100 border-t border-gray-100">
                    <div class="p-3 text-center">
                      <div class="text-lg font-bold text-gray-900">3.2K</div>
                      <div class="text-xs text-gray-500">Reach</div>
                    </div>
                    <div class="p-3 text-center">
                      <div class="text-lg font-bold text-gray-900">89</div>
                      <div class="text-xs text-gray-500">Clicks</div>
                    </div>
                    <div class="p-3 text-center">
                      <div class="text-lg font-bold text-green-600">14</div>
                      <div class="text-xs text-gray-500">Leads</div>
                    </div>
                  </div>
                </div>
                <div class="absolute -right-3 -top-3 rounded-full bg-green-500 px-3 py-1.5 text-xs font-bold text-white shadow-lg">
                  14 Leads Generated
                </div>
              </div>
            )
          }

          <!-- TRACKING MOCKUP -->
          {
            hero.visual === "tracking" && (
              <div class="relative w-full max-w-md">
                <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl">
                  <div class="bg-blue-600 px-5 py-4">
                    <div class="text-sm font-semibold text-white">
                      Analytics Overview
                    </div>
                    <div class="mt-1 text-xs text-blue-200">
                      Last 30 days — GA4 connected
                    </div>
                  </div>
                  <div class="grid grid-cols-3 divide-x divide-gray-100 border-b border-gray-100">
                    <div class="p-4 text-center">
                      <div class="text-xl font-bold text-gray-900">842</div>
                      <div class="text-xs text-gray-500">Sessions</div>
                    </div>
                    <div class="p-4 text-center">
                      <div class="text-xl font-bold text-gray-900">601</div>
                      <div class="text-xs text-gray-500">Users</div>
                    </div>
                    <div class="p-4 text-center">
                      <div class="text-xl font-bold text-green-600">28</div>
                      <div class="text-xs text-gray-500">Leads</div>
                    </div>
                  </div>
                  <div class="space-y-2 p-4">
                    <div class="flex items-center justify-between rounded-lg bg-green-50 border border-green-200 p-3">
                      <span class="text-sm text-gray-700">📞 Phone clicks</span>
                      <span class="text-sm font-bold text-green-700">
                        19 tracked
                      </span>
                    </div>
                    <div class="flex items-center justify-between rounded-lg bg-blue-50 border border-blue-200 p-3">
                      <span class="text-sm text-gray-700">
                        📋 Form submissions
                      </span>
                      <span class="text-sm font-bold text-blue-700">
                        9 tracked
                      </span>
                    </div>
                    <div class="flex items-center justify-between rounded-lg bg-gray-50 border border-gray-200 p-3">
                      <span class="text-sm text-gray-700">
                        🔎 Search Console
                      </span>
                      <span class="text-sm font-bold text-gray-700">
                        Connected ✓
                      </span>
                    </div>
                  </div>
                </div>
                <div class="absolute -right-3 -top-3 rounded-full bg-green-500 px-3 py-1.5 text-xs font-bold text-white shadow-lg">
                  28 Leads Tracked
                </div>
              </div>
            )
          }

          <!-- CRM MOCKUP -->
          {
            hero.visual === "crm" && (
              <div class="relative w-full max-w-md">
                <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl">
                  <div class="bg-blue-600 px-5 py-4">
                    <div class="text-sm font-semibold text-white">
                      Lead Pipeline
                    </div>
                    <div class="mt-1 text-xs text-blue-200">
                      This week — 14 active leads
                    </div>
                  </div>
                  <div class="grid grid-cols-4 gap-2 p-4">
                    {[
                      {
                        label: "New",
                        count: 3,
                        color: "bg-blue-100 text-blue-700",
                      },
                      {
                        label: "Contacted",
                        count: 5,
                        color: "bg-yellow-100 text-yellow-700",
                      },
                      {
                        label: "Quoted",
                        count: 2,
                        color: "bg-orange-100 text-orange-700",
                      },
                      {
                        label: "Won",
                        count: 4,
                        color: "bg-green-100 text-green-700",
                      },
                    ].map(({ label, count, color }) => (
                      <div class="text-center">
                        <div
                          class={`rounded-full px-2 py-1 text-xs font-bold mb-2 ${color}`}
                        >
                          {label}
                        </div>
                        <div class="text-xl font-bold text-gray-900">
                          {count}
                        </div>
                      </div>
                    ))}
                  </div>
                  <div class="space-y-2 border-t border-gray-100 p-4">
                    {[
                      "Johnson Remodel — New lead ✉",
                      "Smith Flooring — Follow-up due",
                      "Garcia — Quote sent 2d ago",
                    ].map((item) => (
                      <div class="flex items-center gap-2 rounded-lg bg-gray-50 px-3 py-2">
                        <div class="h-6 w-6 shrink-0 rounded-full bg-blue-200 text-xs flex items-center justify-center font-bold text-blue-700">
                          {item[0]}
                        </div>
                        <span class="text-xs text-gray-700 truncate">
                          {item}
                        </span>
                      </div>
                    ))}
                  </div>
                  <div class="px-4 pb-4">
                    <div class="flex items-center justify-between rounded-lg bg-green-50 border border-green-200 p-2.5">
                      <span class="text-xs text-gray-600">Auto-follow-up</span>
                      <span class="text-xs font-bold text-green-700">
                        Active ✓
                      </span>
                    </div>
                  </div>
                </div>
                <div class="absolute -right-3 -top-3 rounded-full bg-green-500 px-3 py-1.5 text-xs font-bold text-white shadow-lg">
                  No Leads Lost
                </div>
              </div>
            )
          }
        </div><!-- end right visual -->
      </div>
    </div>
  </section>

  <!-- ─── 2. TRUST STRIP ───────────────────────────────────────────────── -->
  <div class="border-y border-border bg-muted/30">
    <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        {
          [
            { icon: "lucide:map-pin", label: "Washington State" },
            { icon: "lucide:wrench", label: "Founder-Led Work" },
            { icon: "lucide:search", label: "SEO-First Structure" },
            { icon: "lucide:chart-bar", label: "Tracking & Analytics" },
            { icon: "lucide:globe", label: "WordPress, Astro & Google Ads" },
          ].map(({ icon, label }) => (
            <div class="flex items-center gap-2 text-sm text-muted-foreground">
              <Icon name={icon} class="h-4 w-4 text-primary shrink-0" />
              <span>{label}</span>
            </div>
          ))
        }
      </div>
