---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Content from "@/components/widgets/Content.astro";
import ServiceList from "@/components/widgets/ServiceList.astro";
import Features from "@/components/widgets/Features.astro";
import CTASection from "@/components/widgets/CTASection.astro";

const services = [
  {
    title: "Website Design & Development",
    description:
      "Modern, fast, SEO-friendly websites for local service businesses. WordPress, Elementor, and Astro builds with conversion-focused structure and lead capture.",
    icon: "lucide:globe",
    href: "/services/website-design-development",
  },
  {
    title: "SEO & Local SEO",
    description:
      "Keyword research, on-page SEO, Google Business Profile optimization, service area pages, and technical SEO basics to help local customers find you.",
    icon: "lucide:search",
    href: "/services/seo-local-seo",
  },
  {
    title: "Google Ads",
    description:
      "Search campaign setup, keyword strategy, ad copy, conversion tracking, and ongoing optimization for local service businesses.",
    icon: "lucide:target",
    href: "/services/google-ads",
  },
  {
    title: "Meta Ads",
    description:
      "Facebook and Instagram lead generation campaigns with creative strategy, lead form structure, and campaign setup and testing.",
    icon: "lucide:layout-grid",
    href: "/services/meta-ads",
  },
  {
    title: "Tracking & Analytics",
    description:
      "GA4 setup, Google Tag Manager, Search Console, phone click tracking, form submission tracking, and Microsoft Clarity behavior review.",
    icon: "lucide:chart-bar",
    href: "/services/tracking-analytics",
  },
  {
    title: "CRM & Automation",
    description:
      "Lead capture workflows, follow-up systems, Google Sheets and CRM integrations, and simple automation to help you stop losing leads.",
    icon: "lucide:workflow",
    href: "/services/crm-automation",
  },
];

const approachItems = [
  {
    icon: "lucide:layers",
    title: "Foundation First",
    description:
      "A solid website, clear service pages, and proper tracking are set up before adding paid traffic.",
    iconClass: "bg-blue-500/10 text-blue-400",
  },
  {
    icon: "lucide:activity",
    title: "Then Drive Traffic",
    description:
      "Once the foundation is in place, Google Ads, local SEO, or Meta Ads bring in qualified visitors.",
    iconClass: "bg-green-500/10 text-green-400",
  },
  {
    icon: "lucide:refresh-cw",
    title: "Track and Improve",
    description:
      "Conversion tracking and reporting show what is working, so we can optimize over time.",
    iconClass: "bg-purple-500/10 text-purple-400",
  },
];

const metadata = {
  title: "Digital Marketing Services for Local Businesses | JMironov Studio",
  description:
    "Website design, SEO, local SEO, Google Ads, Meta Ads, tracking, and automation services for local businesses in Vancouver WA and Portland Metro.",
};
---

<BaseLayout {metadata}>
  <Content
    tagline="Services"
    title="Services for Local Businesses"
    description={[
      "JMironov Studio offers web design, SEO, advertising, tracking, and automation services built specifically for local service businesses in Vancouver WA and the Portland Metro area.",
    ]}
  />

  <ServiceList services={services} classes={{ container: "pt-0 md:pt-0" }} />

  <Features
    tagline="How It Fits Together"
    title="A Connected Approach"
    subtitle="Each service is more effective when the other pieces are in place. Here is the general order that makes sense."
    features={approachItems}
  />

  <!-- Service areas note -->
  <div class="mx-auto max-w-4xl px-4 py-6 sm:px-6 lg:px-8">
    <div
      class="bg-card border border-border rounded-2xl p-6 text-center shadow-sm"
    >
      <p class="text-sm text-muted-foreground">
        <span class="font-semibold text-foreground">Service area:</span> Vancouver
        WA, Clark County, Portland Metro, and broader Washington and Oregon for digital
        services.
      </p>
    </div>
  </div>

  <CTASection
    title="Not Sure Where to Start?"
    subtitle="Book a free consultation and we'll talk through your situation — website, SEO, ads, tracking, or all of the above."
    primaryText="Book a Free Consultation"
    primaryHref="/contact"
    secondaryText="View Pricing"
    secondaryHref="/pricing"
  />
</BaseLayout>
