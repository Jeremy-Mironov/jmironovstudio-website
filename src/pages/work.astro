---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Content from "@/components/widgets/Content.astro";
import CTASection from "@/components/widgets/CTASection.astro";

const metadata = {
  title: "Selected Work | JMironov Studio",
  description:
    "View selected website, SEO, advertising, and local business marketing projects by JMironov Studio in Vancouver WA.",
};

const projects = [
  {
    name: "FreshFit Bath",
    industry: "Bath & Shower Remodeling",
    url: "https://freshfitbath.com/",
    image: "/work/freshfit-bath.png",
    imageAlt:
      "FreshFit Bath & Shower website — bathroom remodeling in Portland OR area",
    services: [
      "Website Design & Development",
      "SEO",
      "Service Pages",
      "Tracking Setup",
      "Ads Support",
    ],
    description:
      "A local remodeling brand focused on wet-area bathroom services including walk-in showers, tub replacements, and bathroom updates. The project was built around clear service pages, local SEO structure, lead capture forms, and advertising support.",
    approach: [
      "Website structured around core service types and service areas",
      "Service pages built for local search visibility",
      "Contact forms and call-to-action placement focused on lead capture",
      "Conversion tracking configured before running paid ads",
    ],
    tags: ["Website", "SEO", "Tracking"],
  },
  {
    name: "Dwell Installations",
    industry: "Flooring Installation",
    url: "https://dwellinc.net/",
    image: "/work/dwell-installations.png",
    imageAlt:
      "Dwell Installations flooring installation website — Vancouver WA and Portland area",
    services: [
      "Website Direction",
      "Google Ads Planning",
      "Local SEO",
      "Service Page Strategy",
    ],
    description:
      "A flooring installation business offering laminate, vinyl plank, hardwood, and baseboard installation services. The marketing direction focused on local search visibility, clear service descriptions, and lead generation through paid search.",
    approach: [
      "Service page strategy organized around specific flooring types",
      "Local keyword research focused on installation searches",
      "Google Ads campaign structure planned around high-intent keywords",
      "Service area targeting for local neighborhoods and cities",
    ],
    tags: ["Website", "SEO", "Google Ads"],
  },
  {
    name: "AcreMaker NW",
    industry: "Land Clearing & Outdoor Property Services",
    url: "https://acremakernw.com/",
    image: "/work/acremakernw-alt.png",
    imageAlt: "AcreMaker NW land clearing services website — Vancouver WA",
    services: [
      "Website Structure",
      "Service Business Marketing Direction",
      "Local SEO Planning",
    ],
    description:
      "A local service business website focused on land clearing and outdoor property services. The project was structured to make services easier to understand and help potential customers take the next step toward contacting the business.",
    approach: [
      "Website structure designed around service clarity and easy navigation",
      "Content organized to answer common customer questions",
      "Local SEO planning for service area visibility",
      "Contact path and calls to action made prominent throughout",
    ],
    tags: ["Website", "Local SEO"],
  },
];
---

<BaseLayout {metadata}>
  <Content
    tagline="Selected Work"
    title="Projects & Case Studies"
    description={[
      "A selection of website, SEO, advertising, and marketing projects for local service businesses. Each project is built around specific business goals — more leads, better local visibility, and clearer online presence.",
    ]}
  />

  <!-- Projects -->
  <div class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
    <div class="space-y-10">
      {
        projects.map((project) => (
          <div class="bg-card border border-border rounded-3xl overflow-hidden shadow-sm reveal">
            <div class="relative h-56 md:h-72 w-full overflow-hidden border-b border-border">
              <img
                src={project.image}
                alt={project.imageAlt}
                class="w-full h-full object-cover object-top transition-transform duration-500 hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-linear-to-t from-black/40 via-transparent to-transparent" />
              <div class="absolute bottom-4 left-6 flex items-center gap-3">
                <span class="bg-primary/90 text-white text-xs font-bold px-3 py-1 rounded-full backdrop-blur-sm">
                  {project.industry}
                </span>
              </div>
            </div>

            <div class="p-8">
              <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
                <div class="lg:col-span-1">
                  <h2 class="text-2xl font-bold text-foreground mb-1">
                    {project.name}
                  </h2>
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm text-primary hover:underline inline-flex items-center gap-1 mb-4"
                  >
                    {project.url.replace("https://", "")}
                    <svg
                      class="w-3 h-3"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                      />
                    </svg>
                  </a>

                  <div class="mb-4">
                    <p class="text-xs font-semibold text-foreground uppercase tracking-wider mb-2">
                      Services
                    </p>
                    <ul class="space-y-1">
                      {project.services.map((s) => (
                        <li class="flex items-center gap-2 text-sm text-muted-foreground">
                          <svg
                            class="w-3.5 h-3.5 text-primary shrink-0"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M5 13l4 4L19 7"
                            />
                          </svg>
                          {s}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="flex flex-wrap gap-2 mt-4">
                    {project.tags.map((tag) => (
                      <span class="bg-primary/10 text-primary text-xs font-semibold px-3 py-1 rounded-full">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>

                <div class="lg:col-span-2">
                  <p class="text-muted-foreground leading-relaxed mb-6">
                    {project.description}
                  </p>

                  <div>
                    <p class="text-sm font-semibold text-foreground mb-3">
                      Project Focus
                    </p>
                    <ul class="space-y-2">
                      {project.approach.map((item) => (
                        <li class="flex items-start gap-3 text-sm text-muted-foreground">
                          <svg
                            class="w-4 h-4 text-primary shrink-0 mt-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M5 13l4 4L19 7"
                            />
                          </svg>
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="mt-6">
                    <a
                      href={project.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline transition-all"
                    >
                      View live site
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Disclaimer -->
  <div class="mx-auto max-w-3xl px-4 pb-8 sm:px-6 lg:px-8">
    <div class="bg-muted/50 border border-border rounded-2xl p-5 text-center">
      <p class="text-xs text-muted-foreground leading-relaxed">
        Project descriptions reflect the scope and direction of work, not
        specific performance metrics or revenue results. All work is described
        as "built to support," "focused on," or "structured for" specific goals.
      </p>
    </div>
  </div>

  <CTASection
    title="Working on a Similar Project?"
    subtitle="If you run a local service business and need a better website, SEO, or advertising setup — book a free consultation."
    primaryText="Book a Free Consultation"
    primaryHref="/contact"
    secondaryText="View Services"
    secondaryHref="/services"
  />
</BaseLayout>
