---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Content from "@/components/widgets/Content.astro";
import { siteConfig } from "@/config/site";

const metadata = {
  title: "Contact JMironov Studio | Book a Free Consultation",
  description:
    "Contact JMironov Studio to discuss your website, SEO, Google Ads, tracking, or automation project. Based in Vancouver, WA.",
};

// Web3Forms access key. Set WEB3FORMS_ACCESS_KEY in .env (and in the Vercel
// project's environment variables). The key is public by design — it only
// identifies which inbox submissions are delivered to.
const accessKey = import.meta.env.WEB3FORMS_ACCESS_KEY ?? "";

if (!accessKey) {
  console.warn(
    "\n[contact.astro] WEB3FORMS_ACCESS_KEY is not set — the contact form will not deliver submissions.\n" +
      "Get a key at https://web3forms.com and add WEB3FORMS_ACCESS_KEY=... to .env\n",
  );
}
---

<BaseLayout {metadata}>
  <Content
    tagline="Contact"
    title="Book a Free Consultation"
    description={[
      "Tell me what you are trying to improve — your website, SEO, ads, tracking, or lead follow-up. I'll review your situation and help you understand the best next step.",
    ]}
  />

  <div class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-3">
      <!-- Contact info sidebar -->
      <div class="space-y-6">
        <div class="bg-card border border-border rounded-2xl p-6 shadow-sm">
          <h2 class="text-lg font-bold text-foreground mb-4">
            Contact Details
          </h2>
          <div class="space-y-4">
            <div>
              <p
                class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1"
              >
                Email
              </p>
              <a
                href={`mailto:${siteConfig.contact.email}`}
                class="text-primary hover:underline text-sm"
              >
                {siteConfig.contact.email}
              </a>
            </div>
            <div>
              <p
                class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1"
              >
                Phone
              </p>
              <a
                href={`tel:${siteConfig.contact.phone}`}
                class="text-primary hover:underline text-sm"
              >
                {siteConfig.contact.phone}
              </a>
            </div>
            <div>
              <p
                class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1"
              >
                Location
              </p>
              <p class="text-sm text-foreground">Vancouver, WA</p>
            </div>
            <div>
              <p
                class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1"
              >
                Service Area
              </p>
              <p class="text-sm text-muted-foreground">
                Vancouver WA, Clark County, Portland Metro, Washington & Oregon
              </p>
            </div>
          </div>
        </div>

        <div class="bg-card border border-border rounded-2xl p-6 shadow-sm">
          <h2 class="text-base font-bold text-foreground mb-3">
            What Happens Next
          </h2>
          <ol class="space-y-3">
            <li class="flex gap-3 text-sm text-muted-foreground">
              <span class="font-bold text-primary shrink-0">1.</span>
              <span>You fill out the form or email me directly.</span>
            </li>
            <li class="flex gap-3 text-sm text-muted-foreground">
              <span class="font-bold text-primary shrink-0">2.</span>
              <span
                >I review your message and respond within one business day.</span
              >
            </li>
            <li class="flex gap-3 text-sm text-muted-foreground">
              <span class="font-bold text-primary shrink-0">3.</span>
              <span>We schedule a free 30-minute consultation call.</span>
            </li>
            <li class="flex gap-3 text-sm text-muted-foreground">
              <span class="font-bold text-primary shrink-0">4.</span>
              <span
                >I share my honest assessment and recommended next steps.</span
              >
            </li>
          </ol>
        </div>
      </div>

      <!-- Contact form -->
      <div class="lg:col-span-2">
        <div class="bg-card border border-border rounded-3xl p-8 shadow-sm">
          <h2 class="text-xl font-bold text-foreground mb-6">
            Tell Me About Your Project
          </h2>

          <!-- Success panel (revealed after a successful submission) -->
          <div
            id="contact-success"
            class="hidden"
            role="status"
            aria-live="polite"
          >
            <div
              class="rounded-2xl border border-primary/30 bg-primary/5 p-8 text-center"
            >
              <div
                class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/15"
                aria-hidden="true"
              >
                <svg
                  class="h-6 w-6 text-primary"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-foreground mb-2">
                Thanks — your message is on its way.
              </h3>
              <p class="text-sm text-muted-foreground max-w-md mx-auto">
                I'll review what you sent and get back to you within one
                business day. If it's urgent, call or text
                <a
                  href={`tel:${siteConfig.contact.phone}`}
                  class="text-primary font-semibold hover:underline"
                  >{siteConfig.contact.phone}</a
                >.
              </p>
            </div>
          </div>

          <form
            id="contact-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-6"
          >
            <!-- Web3Forms configuration -->
            <input type="hidden" name="access_key" value={accessKey} />
            <input
              type="hidden"
              name="subject"
              value="New consultation request — jmironovstudio.com"
            />
            <input
              type="hidden"
              name="from_name"
              value="JMironov Studio Site"
            />

            <!-- Honeypot: hidden from humans, tempting to bots -->
            <input
              type="checkbox"
              name="botcheck"
              class="hidden"
              style="display:none"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <label
                  for="name"
                  class="block text-sm font-medium text-foreground/80 mb-2"
                >
                  Your Name <span class="text-primary">*</span>
                </label>
                <input
                  type="text"
                  name="name"
                  id="name"
                  autocomplete="name"
                  required
                  class="block w-full rounded-xl border-border bg-muted/50 px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/20 transition-all border outline-none focus:ring-4"
                  placeholder="Your name"
                />
              </div>
              <div>
                <label
                  for="email"
                  class="block text-sm font-medium text-foreground/80 mb-2"
                >
                  Email Address <span class="text-primary">*</span>
                </label>
                <input
                  type="email"
                  name="email"
                  id="email"
                  autocomplete="email"
                  required
                  class="block w-full rounded-xl border-border bg-muted/50 px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/20 transition-all border outline-none focus:ring-4"
                  placeholder="your@email.com"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <label
                  for="phone"
                  class="block text-sm font-medium text-foreground/80 mb-2"
                  >Phone Number</label
                >
                <input
                  type="tel"
                  name="phone"
                  id="phone"
                  autocomplete="tel"
                  class="block w-full rounded-xl border-border bg-muted/50 px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/20 transition-all border outline-none focus:ring-4"
                  placeholder="(360) 555-0000"
                />
              </div>
              <div>
                <label
                  for="business"
                  class="block text-sm font-medium text-foreground/80 mb-2"
                  >Business Name</label
                >
                <input
                  type="text"
                  name="business"
                  id="business"
                  autocomplete="organization"
                  class="block w-full rounded-xl border-border bg-muted/50 px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/20 transition-all border outline-none focus:ring-4"
                  placeholder="Your business name"
                />
              </div>
            </div>

            <div>
              <label
                for="service"
                class="block text-sm font-medium text-foreground/80 mb-2"
              >
                What Are You Interested In? <span class="text-primary">*</span>
              </label>
              <select
                name="service"
                id="service"
                required
                class="block w-full rounded-xl border-border bg-muted/50 px-4 py-3 text-foreground focus:border-primary focus:ring-primary/20 transition-all border outline-none focus:ring-4"
              >
                <option value="" disabled selected>Select a service</option>
                <option value="website">Website Design & Development</option>
                <option value="seo">SEO & Local SEO</option>
                <option value="google-ads">Google Ads</option>
                <option value="meta-ads">Meta Ads (Facebook/Instagram)</option>
                <option value="tracking">Tracking & Analytics Setup</option>
                <option value="crm">CRM & Automation</option>
                <option value="multiple">Multiple Services</option>
                <option value="not-sure">Not Sure Yet</option>
              </select>
            </div>

            <div>
              <label
                for="budget"
                class="block text-sm font-medium text-foreground/80 mb-2"
                >Approximate Budget</label
              >
              <select
                name="budget"
                id="budget"
                class="block w-full rounded-xl border-border bg-muted/50 px-4 py-3 text-foreground focus:border-primary focus:ring-primary/20 transition-all border outline-none focus:ring-4"
              >
                <option value="" disabled selected>Select a range</option>
                <option value="under-1000">Under $1,000</option>
                <option value="1000-2500">$1,000 – $2,500</option>
                <option value="2500-5000">$2,500 – $5,000</option>
                <option value="5000-10000">$5,000 – $10,000</option>
                <option value="10000+">$10,000+</option>
                <option value="not-sure">Not sure yet</option>
              </select>
            </div>

            <div>
              <label
                for="message"
                class="block text-sm font-medium text-foreground/80 mb-2"
              >
                Tell Me About Your Situation <span class="text-primary">*</span>
              </label>
              <textarea
                name="message"
                id="message"
                rows="5"
                required
                minlength="10"
                class="block w-full rounded-xl border-border bg-muted/50 px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/20 transition-all border outline-none focus:ring-4 resize-none"
                placeholder="What does your business do? What is not working right now? What are you trying to improve?"
              ></textarea>
            </div>

            <!-- Error message -->
            <p
              id="contact-error"
              class="hidden rounded-xl border border-red-500/40 bg-red-500/10 px-4 py-3 text-sm text-red-600 dark:text-red-400"
              role="alert"
            >
            </p>

            <div>
              <button
                id="contact-submit"
                type="submit"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 font-bold transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 rounded-xl bg-primary text-white hover:bg-primary/90 transform hover:scale-105 shadow-lg shadow-primary/20 px-8 py-4 text-lg disabled:opacity-60 disabled:pointer-events-none disabled:transform-none"
              >
                <svg
                  id="contact-spinner"
                  class="hidden h-5 w-5 animate-spin motion-reduce:animate-none"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"></circle>
                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                <span id="contact-submit-label">Book a Free Consultation</span>
              </button>
              <p class="mt-3 text-xs text-muted-foreground">
                No obligation. I'll respond within one business day.
              </p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const ENDPOINT = "https://api.web3forms.com/submit";

  interface Web3FormsResponse {
    success?: boolean;
    message?: string;
  }

  function initContactForm() {
    const form = document.getElementById(
      "contact-form",
    ) as HTMLFormElement | null;
    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    const submit = document.getElementById(
      "contact-submit",
    ) as HTMLButtonElement | null;
    const label = document.getElementById("contact-submit-label");
    const spinner = document.getElementById("contact-spinner");
    const errorBox = document.getElementById("contact-error");
    const successBox = document.getElementById("contact-success");

    const setBusy = (busy: boolean) => {
      if (submit) submit.disabled = busy;
      spinner?.classList.toggle("hidden", !busy);
      if (label)
        label.textContent = busy ? "Sending…" : "Book a Free Consultation";
    };

    const showError = (message: string) => {
      if (!errorBox) return;
      errorBox.textContent = message;
      errorBox.classList.remove("hidden");
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorBox?.classList.add("hidden");

      if (!form.reportValidity()) return;

      const payload = Object.fromEntries(new FormData(form));

      if (!payload.access_key) {
        showError(
          "This form isn't configured yet. Please email Jeremymironov@gmail.com or call (971) 326-7264.",
        );
        return;
      }

      setBusy(true);

      try {
        const response = await fetch(ENDPOINT, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        });

        const result: Web3FormsResponse = await response
          .json()
          .catch(() => ({ success: false }));

        if (response.ok && result.success) {
          form.classList.add("hidden");
          successBox?.classList.remove("hidden");
          successBox?.scrollIntoView({ behavior: "smooth", block: "center" });

          // Conversion event — inert until GTM/GA4 is installed.
          const w = window as unknown as {
            dataLayer?: Record<string, unknown>[];
          };
          w.dataLayer = w.dataLayer || [];
          w.dataLayer.push({
            event: "generate_lead",
            form_name: "contact",
            service: payload.service,
            budget: payload.budget,
          });
          return;
        }

        showError(
          result.message ||
            "Something went wrong sending your message. Please email Jeremymironov@gmail.com or call (971) 326-7264.",
        );
      } catch {
        showError(
          "Couldn't reach the server. Check your connection and try again, or email Jeremymironov@gmail.com.",
        );
      } finally {
        setBusy(false);
      }
    });
  }

  document.addEventListener("astro:page-load", initContactForm);
</script>
