---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Content from "@/components/widgets/Content.astro";
import CTASection from "@/components/widgets/CTASection.astro";
import { projects } from "@/data/projects";

const metadata = {
  title: "Projects | JMironov Studio",
  description:
    "View selected website, SEO, advertising, and local business marketing projects by JMironov Studio in Vancouver WA.",
};
---

<BaseLayout {metadata}>
  <Content
    tagline="Selected Work"
    title="Projects"
    description={[
      "A selection of website, SEO, advertising, and marketing projects for local service businesses. Each project page covers the client, the goal, what I did, and the result.",
    ]}
  />

  <!-- Projects -->
  <div class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project) => (
          <a
            href={`/projects/${project.slug}`}
            class="bg-card border border-border rounded-2xl overflow-hidden shadow-sm hover:border-primary/40 hover:shadow-md transition-all reveal group flex flex-col"
          >
            <div class="relative h-48 overflow-hidden border-b border-border">
              <img
                src={project.cardImage}
                alt={project.cardImageAlt}
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-linear-to-t from-black/40 via-transparent to-transparent" />
              <div class="absolute bottom-4 left-5">
                <span class="bg-primary/90 text-white text-xs font-bold px-3 py-1 rounded-full backdrop-blur-sm">
                  {project.industry}
                </span>
              </div>
            </div>

            <div class="p-6 flex flex-col grow">
              <h2 class="text-xl font-bold text-foreground mb-2">
                {project.name}
              </h2>
              <p class="text-sm text-muted-foreground leading-relaxed mb-4">
                {project.summary}
              </p>

              <div class="flex flex-wrap gap-2 mb-5">
                {project.tags.map((tag) => (
                  <span class="bg-primary/10 text-primary text-xs font-semibold px-3 py-1 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>

              <span class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-primary group-hover:underline">
                Learn more
                <svg
                  class="w-4 h-4 transition-transform group-hover:translate-x-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                  />
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>

  <CTASection
    title="Working on a Similar Project?"
    subtitle="If you run a local service business and need a better website, SEO, or advertising setup — book a free consultation."
    primaryText="Book a Free Consultation"
    primaryHref="/contact"
    secondaryText="View Services"
    secondaryHref="/services"
  />
</BaseLayout>
