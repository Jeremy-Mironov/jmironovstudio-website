---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTASection from "@/components/widgets/CTASection.astro";
import ScreenshotThumb from "@/components/ui/ScreenshotThumb.astro";
import { projects, type Project } from "@/data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

const [mainImage, ...restImages] = project.images;
const visibleRest = restImages.slice(0, 3);
const hiddenImages = restImages.slice(3);

const metadata = {
  title: `${project.name} | Projects | JMironov Studio`,
  description: project.summary,
};
---

<BaseLayout {metadata}>
  <!-- Hero -->
  <div class="mx-auto max-w-5xl px-4 pt-12 pb-8 sm:px-6 lg:px-8">
    <a
      href="/projects"
      class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline mb-6"
    >
      <svg
        class="w-4 h-4"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M11 17l-5-5m0 0l5-5m-5 5h12"></path>
      </svg>
      All Projects
    </a>

    <span
      class="bg-primary/10 text-primary text-xs font-bold px-3 py-1 rounded-full"
    >
      {project.industry}
    </span>
    <h1
      class="mt-4 text-4xl md:text-5xl font-bold tracking-tight text-foreground"
    >
      {project.name}
    </h1>
    <p class="mt-4 text-lg text-muted-foreground leading-relaxed max-w-3xl">
      {project.summary}
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-all hover:bg-primary/90 shadow-sm"
      >
        Visit Live Site
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
          ></path>
        </svg>
      </a>
      <div class="flex flex-wrap gap-2">
        {
          project.tags.map((tag) => (
            <span class="bg-muted text-muted-foreground text-xs font-semibold px-3 py-1.5 rounded-full">
              {tag}
            </span>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Screenshots + Client -->
  <div class="mx-auto max-w-5xl px-4 pb-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="space-y-4">
          {
            mainImage && (
              <ScreenshotThumb
                src={mainImage.src}
                alt={mainImage.alt}
                class="aspect-video w-full"
              />
            )
          }

          {
            visibleRest.length > 0 && (
              <div class="grid grid-cols-3 gap-4">
                {visibleRest.map((img, i) => (
                  <ScreenshotThumb
                    src={img.src}
                    alt={img.alt}
                    class="aspect-5/4"
                    overlayCount={
                      i === visibleRest.length - 1 && hiddenImages.length > 0
                        ? hiddenImages.length
                        : undefined
                    }
                  />
                ))}
                {hiddenImages.map((img) => (
                  <button
                    type="button"
                    data-lightbox-trigger
                    data-src={img.src}
                    data-alt={img.alt}
                    class="hidden"
                    tabindex={-1}
                    aria-hidden="true"
                  />
                ))}
              </div>
            )
          }
        </div>
        <p
          class="mt-3 text-right text-xs font-semibold uppercase tracking-wider text-muted-foreground"
        >
          Screenshots
        </p>
      </div>

      <div class="lg:col-span-1">
        <div class="bg-card border border-border rounded-2xl p-6 sticky top-24">
          <p
            class="text-xs font-semibold text-foreground uppercase tracking-wider mb-3"
          >
            Client
          </p>
          <p class="text-foreground font-semibold mb-1">{project.name}</p>
          <p class="text-sm text-muted-foreground mb-5">{project.industry}</p>

          <p
            class="text-xs font-semibold text-foreground uppercase tracking-wider mb-3"
          >
            Technologies Used
          </p>
          <ul class="space-y-2 mb-5">
            {
              project.technologies.map((tech) => (
                <li class="flex items-center gap-2 text-sm text-muted-foreground">
                  <svg
                    class="w-3.5 h-3.5 text-primary shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  {tech}
                </li>
              ))
            }
          </ul>

          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline"
          >
            {project.url.replace("https://", "")}
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Lightbox -->
  <div
    id="lightbox"
    class="fixed inset-0 z-100 hidden items-center justify-center bg-black/90 p-4 sm:p-8"
    role="dialog"
    aria-modal="true"
    aria-label="Screenshot viewer"
  >
    <button
      type="button"
      id="lightbox-close"
      aria-label="Close"
      class="absolute top-4 right-4 rounded-full p-2 text-white/80 transition-colors hover:text-white"
    >
      <svg
        class="h-7 w-7"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <button
      type="button"
      id="lightbox-prev"
      aria-label="Previous screenshot"
      class="absolute left-2 top-1/2 -translate-y-1/2 rounded-full p-2 text-white/80 transition-colors hover:text-white sm:left-4"
    >
      <svg
        class="h-8 w-8"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>
    <button
      type="button"
      id="lightbox-next"
      aria-label="Next screenshot"
      class="absolute right-2 top-1/2 -translate-y-1/2 rounded-full p-2 text-white/80 transition-colors hover:text-white sm:right-4"
    >
      <svg
        class="h-8 w-8"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
    <figure class="flex max-h-full max-w-5xl flex-col items-center">
      <img
        id="lightbox-image"
        src=""
        alt=""
        class="max-h-[80vh] w-auto rounded-xl shadow-2xl"
      />
      <figcaption
        id="lightbox-caption"
        class="mt-3 text-center text-sm text-white/70"
      >
      </figcaption>
    </figure>
  </div>

  <script>
    function initLightbox() {
      const lightbox = document.getElementById("lightbox");
      const triggers = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-lightbox-trigger]"),
      );
      if (!lightbox || !triggers.length) return;

      const imageEl = document.getElementById(
        "lightbox-image",
      ) as HTMLImageElement | null;
      const captionEl = document.getElementById("lightbox-caption");
      const closeBtn = document.getElementById("lightbox-close");
      const prevBtn = document.getElementById("lightbox-prev");
      const nextBtn = document.getElementById("lightbox-next");
      if (!imageEl || !captionEl || !closeBtn || !prevBtn || !nextBtn) return;

      const items = triggers.map((trigger) => ({
        src: trigger.dataset.src ?? "",
        alt: trigger.dataset.alt ?? "",
      }));

      if (items.length <= 1) {
        prevBtn.classList.add("hidden");
        nextBtn.classList.add("hidden");
      }

      let currentIndex = 0;
      let isOpen = false;

      const onKeydown = (e: KeyboardEvent) => {
        if (e.key === "Escape") close();
        if (e.key === "ArrowLeft") show(currentIndex - 1);
        if (e.key === "ArrowRight") show(currentIndex + 1);
      };

      function show(index: number) {
        currentIndex = (index + items.length) % items.length;
        const item = items[currentIndex];
        imageEl!.src = item.src;
        imageEl!.alt = item.alt;
        captionEl!.textContent = item.alt;
        lightbox!.classList.remove("hidden");
        lightbox!.classList.add("flex");
        document.body.style.overflow = "hidden";
        if (!isOpen) {
          document.addEventListener("keydown", onKeydown);
          isOpen = true;
        }
      }

      function close() {
        lightbox!.classList.add("hidden");
        lightbox!.classList.remove("flex");
        document.body.style.overflow = "";
        if (isOpen) {
          document.removeEventListener("keydown", onKeydown);
          isOpen = false;
        }
      }

      triggers.forEach((trigger, i) => {
        trigger.addEventListener("click", () => show(i));
      });

      closeBtn.addEventListener("click", close);
      prevBtn.addEventListener("click", () => show(currentIndex - 1));
      nextBtn.addEventListener("click", () => show(currentIndex + 1));
      lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox) close();
      });
    }

    document.addEventListener("astro:page-load", initLightbox);
  </script>

  <!-- Details -->
  <div class="mx-auto max-w-5xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="space-y-10">
      <div>
        <h2 class="text-2xl font-bold text-foreground mb-3">Project Goal</h2>
        <p class="text-muted-foreground leading-relaxed">{project.goal}</p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-foreground mb-4">What I Did</h2>
        <ul class="space-y-3">
          {
            project.whatIDid.map((item) => (
              <li class="flex items-start gap-3 text-muted-foreground">
                <svg
                  class="w-5 h-5 text-primary shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-foreground mb-3">Result</h2>
        <p class="text-muted-foreground leading-relaxed">{project.result}</p>
      </div>
    </div>
  </div>

  <CTASection
    title="Want Results Like This?"
    subtitle="If you run a local service business and need a better website, SEO, or advertising setup — book a free consultation."
    primaryText="Book a Free Consultation"
    primaryHref="/contact"
    secondaryText="View All Projects"
    secondaryHref="/projects"
  />
</BaseLayout>
