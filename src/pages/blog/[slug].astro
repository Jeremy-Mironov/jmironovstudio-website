---
import DeskLayout from "@/layouts/DeskLayout.astro";
import Schema from "@/components/seo/Schema.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { siteConfig } from "@/config/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const path = `/blog/${post.id}`;
const { title, description, pubDate, author, image } = post.data;
---

<DeskLayout path={path}>
  <Schema
    slot="head"
    type="BlogPosting"
    data={{
      title,
      description,
      image: image ? new URL(image, siteConfig.url).toString() : undefined,
      pubDate,
      author,
      url: `${siteConfig.url}${path}/`,
    }}
  />
</DeskLayout>
