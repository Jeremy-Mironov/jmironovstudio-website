---
import { siteConfig } from "@/config/site";
import ThemeToggle from "@/components/ui/ThemeToggle.astro";
---

<nav
  class="fixed top-0 z-50 w-full border-b border-border bg-background md:bg-background/50 md:backdrop-blur"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8"
  >
    <div class="flex items-center gap-2">
      <a
        href="/"
        class="flex items-center gap-2.5 text-xl font-bold tracking-tight text-foreground transition-colors hover:opacity-90"
      >
        <svg
          width="40"
          height="32"
          viewBox="0 0 256 200"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <defs>
            <linearGradient
              id="navJGrad"
              x1="58"
              y1="34"
              x2="58"
              y2="162"
              gradientUnits="userSpaceOnUse"
            >
              <stop offset="0" stop-color="#FF5B7A"></stop>
              <stop offset="0.55" stop-color="#E33A97"></stop>
              <stop offset="1" stop-color="#8B33CC"></stop>
            </linearGradient>
            <linearGradient
              id="navWarmGrad"
              x1="104"
              y1="34"
              x2="150"
              y2="82"
              gradientUnits="userSpaceOnUse"
            >
              <stop offset="0" stop-color="#FF5E7A"></stop>
              <stop offset="1" stop-color="#FF9A3D"></stop>
            </linearGradient>
            <linearGradient
              id="navCoolGrad"
              x1="132"
              y1="142"
              x2="220"
              y2="34"
              gradientUnits="userSpaceOnUse"
            >
              <stop offset="0" stop-color="#159FD1"></stop>
              <stop offset="1" stop-color="#46E7FF"></stop>
            </linearGradient>
          </defs>
          <path
            d="M76 34V132C76 150 63 162 46 162H40"
            stroke="url(#navJGrad)"
            stroke-width="18"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M104 34L148 80"
            stroke="url(#navWarmGrad)"
            stroke-width="16"
            stroke-linecap="square"></path>
          <path
            d="M132 142L194 72"
            stroke="url(#navCoolGrad)"
            stroke-width="16"
            stroke-linecap="square"></path>
          <path
            d="M218 34V150"
            stroke="url(#navCoolGrad)"
            stroke-width="18"
            stroke-linecap="square"></path>
        </svg>
        {siteConfig.name}
      </a>
    </div>

    <!-- Desktop Menu -->
    <div class="hidden md:block">
      <div class="ml-10 flex items-baseline space-x-8">
        {
          siteConfig.navLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm font-medium text-foreground transition-colors hover:text-primary"
            >
              {link.text}
            </a>
          ))
        }
      </div>
    </div>

    <div class="hidden md:flex items-center gap-4">
      <a
        href="/contact"
        class="rounded-xl bg-primary px-4 py-2 text-sm font-semibold text-white transition-all hover:bg-primary/90 shadow-sm"
      >
        Book a Free Consultation
      </a>
      <ThemeToggle />
    </div>

    <!-- Mobile Menu Button -->
    <div class="md:hidden flex items-center gap-2">
      <ThemeToggle />
      <button
        id="mobile-menu-button"
        type="button"
        class="inline-flex items-center justify-center p-2 rounded-md text-foreground hover:text-white hover:bg-white/10 focus:outline-none transition-colors"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <svg
          id="menu-icon-closed"
          class="block h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="menu-icon-open"
          class="hidden h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="hidden md:hidden" id="mobile-menu">
    <div
      class="space-y-1 border-b border-border bg-background/90 px-2 pb-3 pt-2 sm:px-3"
    >
      {
        siteConfig.navLinks.map((link) => (
          <a
            href={link.href}
            class="block rounded-md px-3 py-2 text-base font-medium text-foreground transition-colors hover:bg-white/10 hover:text-primary"
          >
            {link.text}
          </a>
        ))
      }
      <a
        href="/contact"
        class="block rounded-md px-3 py-2 text-base font-semibold text-primary transition-colors hover:bg-primary/10"
      >
        Book a Free Consultation
      </a>
    </div>
  </div>
</nav>

<script>
  document.addEventListener("astro:page-load", () => {
    const button = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");
    const iconClosed = document.getElementById("menu-icon-closed");
    const iconOpen = document.getElementById("menu-icon-open");

    const newButton = button?.cloneNode(true);
    if (newButton && button && button.parentNode) {
      button.parentNode.replaceChild(newButton, button);
    }

    const finalButton = document.getElementById("mobile-menu-button");

    finalButton?.addEventListener("click", () => {
      const isExpanded = finalButton.getAttribute("aria-expanded") === "true";

      finalButton.setAttribute("aria-expanded", String(!isExpanded));
      menu?.classList.toggle("hidden");
      iconClosed?.classList.toggle("hidden");
      iconOpen?.classList.toggle("hidden");
    });
  });
</script>
