---
// About: a résumé printed on A4 and left in a loose stack on the desk. Turning on slides
// the top sheet off and tucks it under the pile; turning back brings the bottom one up.
import { siteConfig } from "@/config/site";

const contact = siteConfig.contact;
// built as a string: written out in the markup, the second link of the line leaks out of
// its template when Astro compiles it
const contactLine = `${contact.location} · <a href="mailto:${contact.email}">${contact.email}</a> · <a href="tel:+1${contact.phone.replace(/\D/g, "")}">${contact.phone}</a>`;
const CLIP =
  "M8 20 V 52 a6 6 0 0 0 12 0 V 12 a8 8 0 0 0 -16 0 V 46 a4 4 0 0 0 8 0 V 18";
const tools = [
  ["WordPress & Elementor", "sites owners can edit themselves"],
  ["Astro", "fast static sites with a custom structure"],
  ["Google Ads", "search campaigns, keywords, conversion tracking"],
  ["Meta Ads", "Facebook and Instagram lead campaigns"],
  ["GA4 & Tag Manager", "where the leads actually come from"],
  ["Search Console", "search performance and technical SEO"],
  ["Microsoft Clarity", "heatmaps of how visitors use a site"],
  ["CRM & automation", "Sheets workflows and lead follow-up"],
  ["Local SEO", "Business Profile, service-area pages, local keywords"],
];
const values = [
  [
    "Implementation over advice",
    "I set up the site, the tracking, the ads and the automation — not just a list of things to do.",
  ],
  [
    "Marketing built into the website",
    "Clear service pages, fast pages and forms that work, planned from the start.",
  ],
  [
    "Honest about what works",
    "If something isn't worth it at your size, I'll say so. The goal is results.",
  ],
  [
    "Simple systems for small teams",
    "Practical tools a small team can actually use and keep running.",
  ],
];
---

<div class="obj o-resume" data-name="resume">
  <div
    class="ob-body"
    role="region"
    aria-label="About — Jeremy Mironov's résumé"
  >
    <figure class="r-photo lbable">
      <img
        src="/desk/img/about-office.jpg"
        alt="The JMironov Studio workspace in Vancouver, WA"
      />
      <figcaption>the studio, Vancouver WA</figcaption>
      <svg class="clip" viewBox="0 0 24 64" aria-hidden="true">
        <path
          d={CLIP}
          fill="none"
          stroke="#7d858e"
          stroke-width="2.8"
          stroke-linecap="round"></path>
        <path
          d={CLIP}
          fill="none"
          stroke="#eef2f6"
          stroke-width="1"
          stroke-linecap="round"
          transform="translate(-.7 -.7)"></path>
      </svg>
    </figure>
    <div class="sticky y r-note">
      <div class="b">Need the PDF?</div>
      <div>Ask and I'll send my full résumé.</div>
      <a class="sk-link" href="/contact">request my résumé ✉</a>
      <div
        class="tape"
        style="left: 60px; top: -12px; width: 70px; rotate: 3deg"
      >
      </div>
    </div>
    <div class="r-ring" aria-hidden="true"></div>
    <div class="book rsm stack">
      <div class="bk-page bk-l"></div>
      <div class="bk-page bk-r"></div>
      <button class="mcorner l" data-step="-1" aria-label="Previous sheet"
      ></button>
      <button class="mcorner r" data-step="1" aria-label="Next sheet"></button>
      <div class="mnav">
        <button class="sk-btn" data-step="-1">‹ back</button>
        <span class="bk-num hand"></span>
        <button class="sk-btn" data-step="1">next ›</button>
      </div>

      <template data-flow="rflow" data-owner="/about" data-title="Résumé">
        <div class="r-top">
          <h2 class="r-name">Jeremy Mironov</h2>
          <div class="r-role">
            Web development &amp; digital marketing · JMironov Studio
          </div>
          <div class="r-contact" set:html={contactLine} />
        </div>
        <h3 class="r-h">Profile</h3>
        <p>
          I run JMironov Studio, a small web development and digital marketing
          studio in Vancouver, WA. I help local service businesses get more
          leads through better websites, local SEO, advertising, tracking and
          simple automation.
        </p>
        <h3 class="r-h">Background</h3>
        <p>
          Computer science and web development, then several years of building
          websites and running marketing for local and small service businesses.
        </p>
        <p>
          Agencies tend to hand off the technical work; developers tend to
          forget how customers find a site. I work where the two meet: websites
          built with marketing in mind, not just pages that look good.
        </p>
        <h3 class="r-h">Education</h3>
        <div class="r-entry">
          <div class="r-row">
            <b>AAT — Web Development</b><span>exp. 2026</span>
          </div>
          <div class="r-sub">Clark College, Vancouver, WA</div>
          <p>
            JavaScript, PHP &amp; MySQL, WordPress, databases, web servers and
            cloud fundamentals; CTEC 293 capstone.
          </p>
        </div>
        <div class="r-entry">
          <div class="r-row">
            <b>Bachelor's — Computer Science</b><span>2019–2023</span>
          </div>
          <div class="r-sub">Tambov State Technical University</div>
        </div>
        <h3 class="r-h">Training &amp; recognition</h3>
        <p>AWS Academy Cloud Foundations · Phi Theta Kappa · Oswald Award</p>
        <h3 class="r-h">Tools &amp; platforms</h3>
        <ul class="r-tools">
          {
            tools.map(([t, d]) => (
              <li>
                <b>{t}</b> — {d}
              </li>
            ))
          }
        </ul>
        <h3 class="r-h">How I work</h3>
        <div class="r-values">
          {
            values.map(([t, d]) => (
              <div>
                <b>{t}</b>
                <p>{d}</p>
              </div>
            ))
          }
        </div>
        <blockquote class="r-quote">
          “I build websites with marketing in mind — structured to help people
          find your business, understand your services, and contact you.”
        </blockquote>
        <div class="r-sign">Jeremy Mironov</div>
        <ul class="r-links">
          <li>
            <a
              href={siteConfig.socialLinks.linkedin}
              target="_blank"
              rel="noopener noreferrer">LinkedIn ↗</a>
          </li>
          <li>
            <a
              href={siteConfig.socialLinks.github}
              target="_blank"
              rel="noopener noreferrer">GitHub ↗</a>
          </li>
          <li><a href="/projects">Case studies</a></li>
          <li><a href="/contact">Request my résumé</a></li>
        </ul>
      </template>
      <template data-shell>
        <section class="rp">
          <div class="r-run">
            <span>Jeremy Mironov</span><span>Résumé</span>
          </div>
          <div class="flowbox">%flow%</div>
          <div class="r-pn">%n% / %of%</div>
        </section>
      </template>
    </div>
    <div class="ptag" style="left: 1150px; top: 60px; rotate: 4deg">about</div>
  </div>
  <a
    class="grab"
    href="/about"
    data-obj="resume"
    data-keep
    aria-label="Open the résumé"
    style="left: 470px; top: 30px; width: 660px; height: 930px"></a>
</div>
