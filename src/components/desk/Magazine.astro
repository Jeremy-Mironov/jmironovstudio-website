---
// The blog as a magazine issue: a photo cover and the contents, then every post as a
// feature: an opener page with its photo and headline on the left of a spread, the text
// set in two columns from the facing page on. Text pages are cut in the browser (see
// scripts/desk/book.js).
import { render } from "astro:content";
import { blogPosts, deskImage, postDate } from "@/data/desk";

const posts = await blogPosts();
const issues = await Promise.all(
  posts.map(async (post) => {
    const { Content, remarkPluginFrontmatter } = await render(post);
    const minutes = remarkPluginFrontmatter?.minutesRead as number | undefined;
    return {
      post,
      Content,
      href: `/blog/${post.id}`,
      kick: post.data.category ?? "Field Notes",
      image: post.data.image ? deskImage(post.data.image, "blog") : "",
      read: minutes ? `${Math.ceil(minutes)} min read` : "",
    };
  }),
);
const latest = issues[0];
const issue = String(posts.length).padStart(2, "0");
const dated = posts.length
  ? posts[0].data.pubDate.toLocaleDateString("en-US", {
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    })
  : "";
---

<div class="obj o-magazine" data-name="magazine">
  <div class="ob-body" role="region" aria-label="Field Notes — the blog">
    <div class="book mag">
      <div class="bk-edge l" aria-hidden="true"></div>
      <div class="bk-edge r" aria-hidden="true"></div>
      <div class="bk-page bk-l"></div>
      <div class="bk-page bk-r"></div>
      <button class="mcorner l" data-step="-1" aria-label="Previous pages"
      ></button>
      <button class="mcorner r" data-step="1" aria-label="Next pages"></button>
      <div class="mnav">
        <button class="sk-btn" data-step="-1">‹ back</button>
        <span class="bk-num hand"></span>
        <button class="sk-btn" data-step="1">next ›</button>
        <a class="sk-btn bk-home" href="/blog">contents</a>
      </div>
      <div class="ptag" style="left: 30px; top: 40px; rotate: -6deg">blog</div>

      <template data-page data-owner="/blog">
        <section class="mp mp-cover">
          {latest?.image && <img class="cv-img" src={latest.image} alt="" />}
          <div class="cv-shade"></div>
          <div class="cv-top">
            <div class="cv-mast">Field <em>Notes</em></div>
            <div class="cv-line">
              <span>The JMironov Studio journal</span>
              <span>No. {issue} · {dated}</span>
            </div>
          </div>
          {
            latest && (
              <a class="cv-lead" href={latest.href}>
                <span class="cv-k">{latest.kick}</span>
                <span class="cv-t">{latest.post.data.title}</span>
              </a>
            )
          }
          <ul class="cv-more">
            {
              issues.slice(1, 4).map((i) => (
                <li>
                  <a href={i.href}>
                    <b>{i.kick}</b>
                    {i.post.data.title}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="cv-bar" aria-hidden="true"><i></i>free · no. {issue}</div>
        </section>
      </template>
      <template data-page data-owner="/blog">
        <section class="mp mp-toc">
          <div class="mhead">
            <span>Field Notes</span><span>No. {issue}</span>
          </div>
          <h2 class="toc-h">Contents</h2>
          <ol class={posts.length > 5 ? "mtoc many" : "mtoc"}>
            {
              issues.map((i) => (
                <li>
                  <a href={i.href}>
                    <span class="mn" data-pn={i.href} />
                    {i.image && <img src={i.image} alt="" />}
                    <span class="mtx">
                      <span class="mk">{i.kick}</span>
                      <span class="mt">{i.post.data.title}</span>
                      <span class="md">{i.post.data.description}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>
          <p class="ed-note">
            <b>From the editor.</b> Plain-English notes on websites, local SEO, ads
            and follow-up, written for people who run local service businesses.
            <span class="sig">Jeremy</span>
          </p>
          <div class="mfoot">
            <span>jmironovstudio.com/blog</span><span>%n%</span>
          </div>
        </section>
      </template>

      {
        issues.map((i) => (
          <Fragment>
            <template
              data-page
              data-start
              data-owner={i.href}
              data-title={i.post.data.title}
            >
              <section class="mp mp-open">
                {i.image && (
                  <figure class="op-fig lbable">
                    <img src={i.image} alt={i.post.data.title} />
                  </figure>
                )}
                <div class="op-text">
                  <div class="mkick">
                    {i.kick} · {postDate(i.post.data.pubDate)}
                  </div>
                  <h2 class="op-title">{i.post.data.title}</h2>
                  <p class="op-deck">{i.post.data.description}</p>
                  <div class="mby">
                    By {i.post.data.author}
                    {i.read && ` · ${i.read}`}
                  </div>
                </div>
                <div class="mfoot">
                  <>
                    <span>Field Notes · {i.kick}</span>
                    <span>%n%</span>
                  </>
                </div>
              </section>
            </template>
            <template
              data-flow="mflow"
              data-cols="2"
              data-owner={i.href}
              data-kick={i.kick}
              data-title={i.post.data.title}
            >
              <div class="mbody">
                <i.Content />
              </div>
              <p class="mend">
                <span>■</span>{" "}
                <a href="/contact">
                  Questions about your own site? Write me a letter →
                </a>
              </p>
            </template>
          </Fragment>
        ))
      }

      <template data-shell>
        <section class="mp">
          <div class="mhead"><span>Field Notes</span><span>%kick%</span></div>
          <div class="flowbox">%flow%</div>
          <div class="mfoot"><span>%title%</span><span>%n%</span></div>
        </section>
      </template>
      <template data-filler>
        <section class="mp mp-house">
          <div class="mhead">
            <span>Field Notes</span><span>Advertisement</span>
          </div>
          <div class="house">
            <div class="house-k">JMironov Studio · Vancouver, WA</div>
            <div class="house-h">Get found.<br /><em>Get called.</em></div>
            <p class="house-p">
              Websites, local SEO, Google Ads and tracking for local service
              businesses in Vancouver WA &amp; Portland Metro.
            </p>
            <a class="house-cta" href="/contact">Book a free consultation →</a>
          </div>
          <p class="fl-next">
            Next in this issue: <a href="/blog"
              ><span class="fl-title"></span> →</a
            >
          </p>
          <div class="mfoot">
            <span>jmironovstudio.com</span><span>%n%</span>
          </div>
        </section>
      </template>
    </div>
  </div>
  <a
    class="grab"
    href="/blog"
    data-obj="magazine"
    data-keep
    aria-label="Open the blog magazine"
    style="left: 226px; top: 128px; width: 1150px; height: 748px"></a>
</div>
